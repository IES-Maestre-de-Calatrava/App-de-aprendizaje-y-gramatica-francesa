CREATE DATABASE modeloRelacional;
USE modeloRelacional;

CREATE TABLE PROFESOR (
	ID_PROFESOR INT(10)  AUTO_INCREMENT NOT NULL,
    NOMBRE VARCHAR(20) NOT NULL,
    APELLIDO VARCHAR(40) NOT NULL,
    CENTRO VARCHAR(50) NOT NULL,
    EMAIL VARCHAR(20) NOT NULL UNIQUE,
    CONTRASENA VARCHAR(25) NOT NULL,
    CONSTRAINT PK_PROFESOR PRIMARY KEY (ID_PROFESOR)
);

CREATE TABLE EJERCICIO(
	ID_EJERCICIO INT(10) AUTO_INCREMENT NOT NULL,
    PUNTOS INT(2) NOT NULL,
    ENLACE VARCHAR(100) NOT NULL,
    HORA_SUBIDA TIMESTAMP NOT NULL,
    CONSTRAINT PK_EJERCICIO PRIMARY KEY (ID_EJERCICIO)
);

CREATE TABLE CLASE(
	ID_CLASE INT(10) AUTO_INCREMENT NOT NULL,
    NOMBRE VARCHAR(20) NOT NULL,
    ID_PROFESOR INT(10) NOT NULL,
    CONSTRAINT PK_CLASE PRIMARY KEY (ID_CLASE),
    CONSTRAINT FK_CLASE_PROFESOR FOREIGN KEY (ID_PROFESOR)
		REFERENCES PROFESOR (ID_PROFESOR)
);

CREATE TABLE ALUMNO(
	ID_ALUMNO INT(10) AUTO_INCREMENT NOT NULL,
    NOMBRE VARCHAR(20) NOT NULL,
    APELLIDO VARCHAR(40) NOT NULL,
    CENTRO VARCHAR(50) NOT NULL,
    EMAIL VARCHAR(20) NOT NULL UNIQUE,
    CONTRASENA VARCHAR(25) NOT NULL,
    NIVEL VARCHAR(15),
    ID_PROFESOR INT(10) NOT NULL,
    ID_CLASE INT(10) NOT NULL,
    CONSTRAINT PK_ALUMNO PRIMARY KEY (ID_ALUMNO),
    CONSTRAINT FK_ALUMNO_PROFESOR FOREIGN KEY (ID_PROFESOR)
		REFERENCES PROFESOR(ID_PROFESOR),
	CONSTRAINT FK_ALUMNO_CLASE FOREIGN KEY (ID_CLASE)
		REFERENCES CLASE (ID_CLASE)
);

CREATE TABLE REALIZA(
	ID_ALUMNO INT(10) NOT NULL,
    ID_EJERCICIO INT(10) NOT NULL,
    CONSTRAINT PK_REALIZA PRIMARY KEY (ID_ALUMNO, ID_EJERCICIO),
    CONSTRAINT FK_REALIZA_ALUMNO FOREIGN KEY (ID_ALUMNO)
		REFERENCES ALUMNO (ID_ALUMNO),
	CONSTRAINT FK_REALIZA_EJERCICIO FOREIGN KEY (ID_EJERCICIO)
		REFERENCES EJERCICIO (ID_EJERCICIO)
);

CREATE TABLE CREA(
	ID_PROFESOR INT(10) NOT NULL,
    ID_EJERCICIO INT(10) NOT NULL,
    CONSTRAINT PK_CREA PRIMARY KEY (ID_PROFESOR),
    CONSTRAINT FK_CREA_PROFESOR FOREIGN KEY (ID_PROFESOR)
		REFERENCES PROFESOR (ID_PROFESOR),
	CONSTRAINT FK_CREA_EJERCICIO FOREIGN KEY (ID_EJERCICIO)
		REFERENCES EJERCICIO (ID_EJERCICIO)
);

CREATE TABLE FORMAN(
	ID_EJERCICIO INT(10) NOT NULL,
    ID_CLASE INT(10) NOT NULL,
    CONSTRAINT PK_FORMAN PRIMARY KEY (ID_EJERCICIO, ID_CLASE),
    CONSTRAINT FK_FORMAN_EJERCICIO FOREIGN KEY (ID_EJERCICIO)
		REFERENCES EJERCICIO (ID_EJERCICIO),
	CONSTRAINT FK_FORMAN_CLASE FOREIGN KEY (ID_CLASE)
		REFERENCES CLASE (ID_CLASE)
);